# Copy to .env, fill in locally, then export with: set -a; source .env; set +a
# Never put real credentials in this example or commit the completed .env file.
OPENAI_API_KEY=
PDF2PODCAST_LLM_BASE_URL="https://api.openai.com/v1"
PDF2PODCAST_LLM_API_KEY=
PDF2PODCAST_LLM_KEY_FILE=
PDF2PODCAST_MOBILE_TOKEN=
PDF2PODCAST_DATA_DIR="$HOME/.pdf2podcast"
PDF2PODCAST_WEB_ROOT="$PWD/apps/Pdf2Podcast/web"
PDF2PODCAST_GOOGLE_CLIENT_ID=
PDF2PODCAST_ADMIN_EMAILS=
PDF2PODCAST_PRIVACY_CONTACT=tanchienhao@gmail.com
PDF2PODCAST_MAX_UPLOAD_BYTES=52428800
PDF2PODCAST_WEB_UPLOADS_PER_MINUTE=20
PDF2PODCAST_WEB_QUEUE_PER_MINUTE=1
# Web accounts accept versioned public-upload terms once during initial account setup.
PDF2PODCAST_SCRIPT_MODEL=gpt-4.1-mini
PDF2PODCAST_LAYOUT_MODEL=gpt-4.1
PDF2PODCAST_LAYOUT_CONCURRENCY=8

# Text requests and speech requests have separate concurrency limits.
PDF2PODCAST_SCRIPT_CONCURRENCY=16
PDF2PODCAST_SUMMARY_CONCURRENCY=16
PDF2PODCAST_OPENAI_CONCURRENCY=16
PDF2PODCAST_LLM_CONCURRENCY=16
PDF2PODCAST_TTS_CONCURRENCY=16
PDF2PODCAST_TTS_CLIP_CONCURRENCY=32
PDF2PODCAST_MEDIA_CONCURRENCY=4
